{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mobile api status API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "status_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mobileapi.dev/status/"
          },
          "docs": "Retrieve the server status"
        }
      ]
    }
  ],
  "bundled": true
}