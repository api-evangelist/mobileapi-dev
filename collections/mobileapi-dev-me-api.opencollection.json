{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mobile api me API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "me",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "me_list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mobileapi.dev/me/"
          }
        }
      ]
    }
  ],
  "bundled": true
}